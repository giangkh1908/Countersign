# .env.example — chỉ các biến docker compose nội suy `${...}`. Sao thành `.env` (gen-secrets.sh làm giúp).
# Secret nằm ở ./secrets/* (gen-secrets.sh sinh), KHÔNG đặt ở đây. Model/alias: packages/gateway/config/models.yaml.

# Profile tự kèm khi `docker compose up`: cache | tickets | notify | obs (ngăn bằng dấu phẩy)
COMPOSE_PROFILES=
# Để trống = dùng model thật trong models.yaml (OpenRouter, cần secrets/openrouter_api_key).
# `mock` = LLM giả, kèm GW_MODELS_CONFIG=/app/packages/gateway/tests/models.test.yaml (embedding mock_hash).
GW_PROVIDER_OVERRIDE=
GW_MODELS_CONFIG=/app/packages/gateway/config/models.yaml
# Cache phản hồi (Q1): off|redis. redis cần COMPOSE_PROFILES có `cache`. Tăng INDEX_VERSION sau khi nạp lại index.
GW_CACHE_ADAPTER=off
GW_CACHE_TTL_S=3600
GW_CACHE_INDEX_VERSION=0
# Kiểm chứng trích dẫn sau sinh (cần LLM thật làm judge; với mock đặt off)
AGENT_VERIFY_CITATIONS=on
# Truy xuất: none | gateway_rerank (cần llama-server --reranking cổng 8081, alias acme-rerank)
DOCS_RERANK=none
# Số chiều embedding (khớp `dim` trong models.yaml); đổi chiều khi đã có dữ liệu thì đặt MIGRATE_FORCE_REEMBED=1 để nạp lại
EMBED_DIM=1024
MIGRATE_FORCE_REEMBED=0
# Telegram (notify-mcp, profile notify): token ở secrets/telegram_bot_token, kênh ở infra/notify/channels.yaml
LOG_LEVEL=INFO
