# .env.example — biến môi trường theo docs/design/contracts.md §8. Sao thành `.env` (gen-secrets.sh làm giúp).
# Quy ước: biến nhạy cảm KHÔNG đặt giá trị ở đây; để trống hoặc trỏ `<BIẾN>_FILE` tới file secret
# (docker compose mount ở /run/secrets/<tên>; chạy ngoài Docker thì trỏ ./secrets/<tên>). Có cả hai thì `_FILE` thắng.
# docker-compose.yml chỉ thay thế các biến có `${...}`; phần còn lại dành cho chạy `uv run` ngoài Docker.

# ───────────── Chung (mọi service) ─────────────
ACME_ENV=dev                       # dev|test|eval  (eval mới cho phép adapter permissive)
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
KEYCLOAK_ISSUER=http://keycloak.acme.local:8080/realms/acme
METRICS_TOKEN=
METRICS_TOKEN_FILE=./secrets/metrics_token

# ───────────── gateway ─────────────
GW_DATABASE_URL=
GW_DATABASE_URL_FILE=./secrets/gw_database_url
GW_KEY_PEPPER=
GW_KEY_PEPPER_FILE=./secrets/gw_key_pepper
GW_KEY_PEPPER_PREV=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=./secrets/anthropic_api_key
AUDIT_HMAC_KEY=
AUDIT_HMAC_KEY_FILE=./secrets/audit_hmac_key
AUDIT_HMAC_KEY_ID=1
# "mock" -> factory thay mọi provider bằng adapter mock
GW_PROVIDER_OVERRIDE=
GW_MOCK_BASE_URL=http://mock-provider:8900

# ───────────── approval-signer ─────────────
SIGNER_PORT=8310
SIGNER_AUDIENCE=approval-signer
SIGNER_ALLOWED_AZP=chat-ui
APPROVAL_SIGNER_PRIVATE_KEY_PATH=./secrets/approval_es256_private.pem
APPROVAL_SIGNER_KEY_ID=ap-1
INTENT_PUBLIC_KEYS_DIR=./secrets/intent-keys
APPROVAL_TTL_S=120

# ───────────── agent ─────────────
AGENT_GATEWAY_URL=http://gateway:8000/v1
AGENT_GATEWAY_KEY=
AGENT_GATEWAY_KEY_FILE=./secrets/agent_gateway_key
AGENT_KC_CLIENT_ID=agent-service
AGENT_KC_CLIENT_SECRET=
AGENT_KC_CLIENT_SECRET_FILE=./secrets/kc_agent_client_secret
AGENT_DATABASE_URL=
AGENT_DATABASE_URL_FILE=
# chỉ job migrate/setup (ag_owner)
AGENT_DATABASE_OWNER_URL=
MCP_DOCS_URL=http://docs-mcp:8101/mcp
MCP_TICKETS_URL=http://tickets-mcp:8102/mcp
AGENT_MAX_TOOL_CALLS_TURN=8
AGENT_MAX_TURN_COST_USD=0.5
AGENT_RECURSION_LIMIT=25
AGENT_CONF_MIN=0.5
AGENT_CHECKPOINT_ENCRYPTION_KEY=
AGENT_CHECKPOINT_ENCRYPTION_KEY_FILE=./secrets/agent_checkpoint_key   # bắt buộc ngoài ACME_ENV=test
AGENT_THREAD_RETENTION_DAYS=30
# Kiểm chứng trích dẫn sau sinh (R2). Bật cần LLM thật làm judge (alias acme-judge). Với mock-provider đặt `off`:
# mock không sinh [#id] nên câu trả lời docs sẽ bị từ chối.
AGENT_VERIFY_CITATIONS=on

# ───────────── bff ─────────────
BFF_PUBLIC_URL=http://localhost:8300
BFF_SESSION_KEY=
BFF_SESSION_KEY_FILE=./secrets/bff_session_key
BFF_OIDC_CLIENT_SECRET=
BFF_OIDC_CLIENT_SECRET_FILE=./secrets/bff_oidc_client_secret
BFF_AGENT_URL=http://agent:8200
BFF_SIGNER_URL=http://approval-signer:8310
BFF_REDIS_URL=redis://bff@redis-state:6379/0
REDIS_BFF_PASSWORD=
REDIS_BFF_PASSWORD_FILE=./secrets/redis_bff_password
BFF_SIGNER_TOKEN_TTL_S=300
BFF_SESSION_IDLE_S=1800
BFF_SESSION_ABS_S=28800
BFF_MAX_CARDS_PER_THREAD_HOUR=10
BFF_STREAM_MAX_S=300
BFF_STREAM_IDLE_S=45
BFF_LINK_ALLOWLIST=
BFF_COOKIE_INSECURE_DEV=false      # chỉ ACME_ENV=dev
BFF_TRUSTED_PROXY=false
BFF_STATIC_DIR=

# ───────────── docs-mcp ─────────────
MCP_AUDIENCE=docs-mcp
MCP_HOST=mcp_sdk                   # mcp_sdk|fastmcp
MCP_PORT=8101
MCP_PUBLIC_URL=
MCP_DATABASE_URL=
MCP_DATABASE_URL_FILE=./secrets/kn_app_password
MCP_REDIS_URL=redis://docs@redis-state:6379/0
MCP_REDIS_PASSWORD_FILE=./secrets/redis_docs_password
DOCS_GATEWAY_URL=http://gateway:8000/v1
DOCS_GATEWAY_KEY=
DOCS_GATEWAY_KEY_FILE=./secrets/docs_gateway_key
DOCS_RERANK=
# Truy xuất docs-mcp (rag-citations §4): vector + Postgres FTS (ts_rank_cd, không phải BM25) trộn RRF.
DOCS_EMBEDDER=gateway_http
DOCS_USE_VECTOR=true
DOCS_USE_FTS=true
DOCS_FTS_MODE=unaccent
DOCS_RRF_K=60
# Cấu hình tạm (ROADMAP R1), chốt khi có bộ 150 câu. Settings không qua compose vẫn giữ 1.0 và off.
DOCS_RRF_WEIGHT_FTS=0.25  # trọng số nhánh FTS trong RRF (vector luôn 1.0)
DOCS_FTS_STOPWORDS=false  # bỏ từ dừng tiếng Việt ở truy vấn FTS
DOCS_FTS_RANK=cd  # cd = ts_rank_cd | rank = ts_rank
DOCS_FTS_TITLE=false  # ghép tiêu đề văn bản (trọng số A) vào tsv lúc truy vấn; không dùng chỉ mục GIN
DOCS_DIRECT_LOOKUP=pin
# Số chiều embedding: knowledge-migrate đưa chunks.embedding về vector(EMBED_DIM) và docs-mcp dùng cùng giá trị (HNSW tối đa 2000).
# Đổi chiều khi chunks còn dữ liệu thì job dừng; đặt MIGRATE_FORCE_REEMBED=1 để xoá chunks và nạp lại.
EMBED_DIM=1024
MIGRATE_FORCE_REEMBED=0
DOCS_RETRIEVER=
TAINT_RECENT_TTL_S=86400
MCP_ALLOWED_AZP=
MCP_ALLOWED_ORIGINS=
MCP_RL_CAPACITY=
MCP_RL_REFILL_PER_S=
MCP_MAX_OUTPUT_BYTES=
MCP_AUDIT_DATABASE_URL=

# ───────────── tickets-mcp (thêm vào nhóm MCP; MCP_AUDIENCE=tickets-mcp, MCP_PORT=8102) ─────────────
INTENT_PRIVATE_KEY_PATH=./secrets/intent_es256_private.pem
# kid = tên file secrets/intent-keys/<iss>/<kid>.pem do gen-secrets.sh tạo
INTENT_KEY_ID=tickets-mcp-1
INTENT_TTL_S=300
APPROVAL_PUBLIC_KEY_PATH=./secrets/approval_es256_public.pem
TAINT_POLICY=warn                  # warn|block
TICKETS_REPOSITORY=
INTENT_ISSUER=es256_jws
APPROVAL_VERIFIER=es256_jwt

# ───────────── redis (mật khẩu qua _FILE) ─────────────
REDIS_TICKETS_PASSWORD_FILE=./secrets/redis_tickets_password
REDIS_DOCS_PASSWORD_FILE=./secrets/redis_docs_password
REDIS_HEALTH_PASSWORD_FILE=./secrets/redis_health_password
REDIS_OPS_PASSWORD_FILE=./secrets/redis_ops_password

# ───────────── keycloak ─────────────
KC_HOSTNAME=http://keycloak.acme.local:8080
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak

# ───────────── mock-provider ─────────────
MOCK_TTFT_MS=300
MOCK_TOKENS_PER_SEC=50
MOCK_OUTPUT_TOKENS=50

# Embedding local (runtime OpenAI-compatible trên host, model 1024 chiều, vd bge-m3). Mặc định vẫn là mock_hash.
# Bỏ comment để gateway dùng; sau đó ingest lại (không cần --force: index_sig đổi theo id model thật).
# GW_MODELS_CONFIG=/app/packages/gateway/config/models.ollama.yaml
